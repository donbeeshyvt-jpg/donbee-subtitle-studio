# 複製為 .env 後填寫；.env 不進版本控制。
# 所有路徑預設相對專案根（config.PROJECT_ROOT）解析，不寫死磁碟代號；只有要改放置位置時才設定下列變數。
# 目前服務不自動讀取 .env：請在啟動前於環境設定，或在 bat 前以 set 指定。

# 模型執行環境（Start-DonBee-Subtitle-Studio.bat 預設使用專案 .venv；此變數可指定既有環境）
# STUDIO_MODEL_PYTHON=

# VibeVoice 指令碼根（預設 docs\VibeVoice-main）
# STUDIO_VIBEVOICE_ROOT=

# 本機模型固定位置（預設 models\；models\hf 存在時 Hugging Face 快取綁到專案內，見 models\README.md）
# STUDIO_MODELS_DIR=

# 隔離下載器（bat 自動偵測 .venv-download）
# STUDIO_YTDLP_PYTHON=

# 本機資料目錄（預設專案內 data\；首次啟動會從舊的 %LOCALAPPDATA%\DongbiStudio 複製遷移，不刪舊資料）
# STUDIO_DATA_DIR=

# 遠端文字模型金鑰：只在後端讀取；也可改由介面填入，存本機資料目錄的 secrets 檔，不進專案
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
# llama.cpp server 若以 --api-key 啟動，填相同值
LLAMACPP_API_KEY=
